<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kidsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EB080A0E"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="60dp"
    android:paddingEnd="60dp"
    android:paddingTop="36dp"
    android:paddingBottom="36dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/btnKidsClose"
                style="@style/TopButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="←"
                android:textSize="20sp"
                android:nextFocusLeft="@id/btnKidsClose"
                android:nextFocusRight="@id/btnTimer15"
                android:nextFocusUp="@id/btnKidsClose"
                android:nextFocusDown="@id/btnTimer15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:text="@string/kids_title"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/txtKidsTimerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:textColor="#80FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Main Card Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/setting_card_bg"
            android:orientation="vertical"
            android:padding="28dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:text="Chọn thời gian tự động tắt TV:"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTimer15"
                    style="@style/SettingOption"
                    android:text="@string/kids_btn_15"
                    android:nextFocusLeft="@id/btnKidsClose"
                    android:nextFocusRight="@id/btnTimer30"
                    android:nextFocusUp="@id/btnKidsClose"
                    android:nextFocusDown="@id/btnKidsChangePin" />

                <TextView
                    android:id="@+id/btnTimer30"
                    style="@style/SettingOption"
                    android:layout_marginStart="14dp"
                    android:text="@string/kids_btn_30"
                    android:nextFocusLeft="@id/btnTimer15"
                    android:nextFocusRight="@id/btnTimer45"
                    android:nextFocusUp="@id/btnKidsClose"
                    android:nextFocusDown="@id/btnKidsChangePin" />

                <TextView
                    android:id="@+id/btnTimer45"
                    style="@style/SettingOption"
                    android:layout_marginStart="14dp"
                    android:text="@string/kids_btn_45"
                    android:nextFocusLeft="@id/btnTimer30"
                    android:nextFocusRight="@id/btnTimer60"
                    android:nextFocusUp="@id/btnKidsClose"
                    android:nextFocusDown="@id/btnKidsChangePin" />

                <TextView
                    android:id="@+id/btnTimer60"
                    style="@style/SettingOption"
                    android:layout_marginStart="14dp"
                    android:text="@string/kids_btn_60"
                    android:nextFocusLeft="@id/btnTimer45"
                    android:nextFocusRight="@id/btnTimerCustom"
                    android:nextFocusUp="@id/btnKidsClose"
                    android:nextFocusDown="@id/btnKidsLockNow" />

                <TextView
                    android:id="@+id/btnTimerCustom"
                    style="@style/SettingOption"
                    android:layout_marginStart="14dp"
                    android:text="@string/kids_btn_custom"
                    android:nextFocusLeft="@id/btnTimer60"
                    android:nextFocusRight="@id/btnTimerOff"
                    android:nextFocusUp="@id/btnKidsClose"
                    android:nextFocusDown="@id/btnKidsLockNow" />

                <TextView
                    android:id="@+id/btnTimerOff"
                    style="@style/SettingOption"
                    android:layout_marginStart="14dp"
                    android:text="@string/kids_btn_off"
                    android:nextFocusLeft="@id/btnTimerCustom"
                    android:nextFocusRight="@id/btnTimerOff"
                    android:nextFocusUp="@id/btnKidsClose"
                    android:nextFocusDown="@id/btnKidsLockNow" />
            </LinearLayout>
        </LinearLayout>

        <!-- PIN and Security Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/setting_card_bg"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:text="Bảo mật &amp; Mã PIN phụ huynh:"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="@string/kids_pin_default_hint"
                android:textColor="#70FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnKidsChangePin"
                    style="@style/SettingOption"
                    android:text="@string/kids_change_pin"
                    android:nextFocusLeft="@id/btnKidsChangePin"
                    android:nextFocusRight="@id/btnKidsLockNow"
                    android:nextFocusUp="@id/btnTimer15"
                    android:nextFocusDown="@id/btnKidsChangePin" />

                <TextView
                    android:id="@+id/btnKidsLockNow"
                    style="@style/SettingOption"
                    android:layout_marginStart="14dp"
                    android:text="@string/kids_lock_now"
                    android:nextFocusLeft="@id/btnKidsChangePin"
                    android:nextFocusRight="@id/btnKidsLockNow"
                    android:nextFocusUp="@id/btnTimerCustom"
                    android:nextFocusDown="@id/btnKidsLockNow" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
