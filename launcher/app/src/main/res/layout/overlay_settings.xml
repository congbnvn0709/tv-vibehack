<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EB080A0E"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSettingsClose"
                        style="@style/TopButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:gravity="center"
                        android:text="←"
                        android:textSize="18sp"
                        android:nextFocusLeft="@id/btnSettingsClose"
                        android:nextFocusRight="@id/btnLangAuto"
                        android:nextFocusUp="@id/btnSettingsClose"
                        android:nextFocusDown="@id/btnLangAuto" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.02"
                        android:text="@string/settings_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="#2E38BDF8"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="TV-VIBEHACK"
                        android:textColor="#38BDF8"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 300"
                    android:text="@string/settings_subtitle"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Two Columns of Setting Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <!-- Card 0: Display Language -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="@string/settings_language_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_language_desc"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnLangAuto"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_lang_auto"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnLangAuto"
                            android:nextFocusUp="@id/btnSettingsClose"
                            android:nextFocusRight="@id/btnLangVi"
                            android:nextFocusDown="@id/btnTopStyleText" />

                        <TextView
                            android:id="@+id/btnLangVi"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_lang_vi"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnLangAuto"
                            android:nextFocusUp="@id/btnSettingsClose"
                            android:nextFocusRight="@id/btnLangEn"
                            android:nextFocusDown="@id/btnTopStyleIcon" />

                        <TextView
                            android:id="@+id/btnLangEn"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_lang_en"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnLangVi"
                            android:nextFocusUp="@id/btnSettingsClose"
                            android:nextFocusRight="@id/btnWallAuto"
                            android:nextFocusDown="@id/btnTopStyleIcon" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 1: Top Bar Style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="@string/settings_top_bar_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_top_bar_desc"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTopStyleText"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_top_style_text"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="14sp"
                            android:nextFocusLeft="@id/btnTopStyleText"
                            android:nextFocusUp="@id/btnLangAuto"
                            android:nextFocusRight="@id/btnTopStyleIcon"
                            android:nextFocusDown="@id/btnPeekUltra" />

                        <TextView
                            android:id="@+id/btnTopStyleIcon"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_top_style_icon"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="14sp"
                            android:nextFocusLeft="@id/btnTopStyleText"
                            android:nextFocusUp="@id/btnLangVi"
                            android:nextFocusRight="@id/btnWallAuto"
                            android:nextFocusDown="@id/btnPeekBalanced" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Dock Peek Depth -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="@string/settings_dock_peek_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_dock_peek_desc"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnPeekUltra"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_dock_ultra"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnPeekUltra"
                            android:nextFocusUp="@id/btnTopStyleText"
                            android:nextFocusRight="@id/btnPeekBalanced"
                            android:nextFocusDown="@id/btnPeekUltra" />

                        <TextView
                            android:id="@+id/btnPeekBalanced"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_dock_balanced"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnPeekUltra"
                            android:nextFocusUp="@id/btnTopStyleIcon"
                            android:nextFocusRight="@id/btnPeekNone"
                            android:nextFocusDown="@id/btnPeekBalanced" />

                        <TextView
                            android:id="@+id/btnPeekNone"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_dock_fixed"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnPeekBalanced"
                            android:nextFocusUp="@id/btnTopStyleIcon"
                            android:nextFocusRight="@id/btnSysSettings"
                            android:nextFocusDown="@id/btnPeekNone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Card 3: Wallpaper Theme -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="@string/settings_wallpaper_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_wallpaper_desc"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnWallAuto"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_wall_auto"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnLangEn"
                            android:nextFocusUp="@id/btnSettingsClose"
                            android:nextFocusRight="@id/btnWallDay"
                            android:nextFocusDown="@id/btnSysSettings" />

                        <TextView
                            android:id="@+id/btnWallDay"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_wall_day"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnWallAuto"
                            android:nextFocusUp="@id/btnSettingsClose"
                            android:nextFocusRight="@id/btnWallNight"
                            android:nextFocusDown="@id/btnSysWifi" />

                        <TextView
                            android:id="@+id/btnWallNight"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_wall_night"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnWallDay"
                            android:nextFocusUp="@id/btnSettingsClose"
                            android:nextFocusRight="@id/btnWallNight"
                            android:nextFocusDown="@id/btnSysApps" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 4: System Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="@string/settings_system_shortcuts_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_system_shortcuts_desc"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSysSettings"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_btn_system"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnPeekNone"
                            android:nextFocusUp="@id/btnWallAuto"
                            android:nextFocusRight="@id/btnSysWifi"
                            android:nextFocusDown="@id/btnSysSettings" />

                        <TextView
                            android:id="@+id/btnSysWifi"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_btn_wifi"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnSysSettings"
                            android:nextFocusUp="@id/btnWallDay"
                            android:nextFocusRight="@id/btnSysApps"
                            android:nextFocusDown="@id/btnSysWifi" />

                        <TextView
                            android:id="@+id/btnSysApps"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="@string/settings_btn_apps"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusLeft="@id/btnSysWifi"
                            android:nextFocusUp="@id/btnWallNight"
                            android:nextFocusRight="@id/btnSysApps"
                            android:nextFocusDown="@id/btnSysApps" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
